# ── Docker Compose Volume Paths ──
MOVIES_WATCH_PATH=/path/to/downloads/movies   # Optional — leave blank for re-encode only mode
TV_WATCH_PATH=/path/to/downloads/tv           # Optional — leave blank for re-encode only mode
MOVIES_OUTPUT_PATH=/path/to/library/movies
TV_OUTPUT_PATH=/path/to/library/tv
TEMP_PATH=/tmp/transcodarr
LOG_PATH=./logs
DATA_PATH=./data
CONFIG_PATH=./config
MEDIA_CACHE_PATH=./data/cache    # Persists scanned media metadata across container rebuilds

# ── PostgreSQL ──
POSTGRES_HOST=postgres          # "postgres" for bundled, or your DB host for external
POSTGRES_PORT=5432
POSTGRES_DB=transcodarr
POSTGRES_USER=transcodarr
POSTGRES_PASSWORD=change-me

# ── Security ──
FLASK_SECRET=change-me-to-a-random-string
ADMIN_API_KEY=change-me-to-a-random-string

# ── Central Syslog (optional) ──
# SYSLOG_ADDRESS=tcp://your-syslog-host:1514

# ── Hardware Transcoding (optional) ──
# Only needed when overlaying a GPU compose file. The base docker-compose.yml is
# GPU-less; hardware is opt-in:
#   Intel/AMD:  docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
#   NVIDIA:     docker compose -f docker-compose.yml -f docker-compose.gpu-nvidia.yml up -d --build
#
# Intel (QSV/VAAPI) + AMD (VAAPI) — docker-compose.gpu.yml
# RENDER_GID is REQUIRED and host-specific; the GID differs per distro
# (Ubuntu 24.04: 993, Debian 12: 106). Find yours with:
#   getent group render | cut -d: -f3
# RENDER_GID=993
# VIDEO_GID=44                 # host "video" group (default 44)
# GPU_DEVICE=/dev/dri          # or pin one node, e.g. /dev/dri/renderD128
#
# NVIDIA (NVENC) — docker-compose.gpu-nvidia.yml; needs nvidia-container-toolkit
# NVIDIA_VISIBLE_DEVICES=all   # or a specific GPU: 0 / GPU-<uuid>
